{
  "name": "hormes",
  "version": "2.0.0",
  "description": "Calendar-aware, voice-first Mac workspace for learning, work, and verified agent execution.",
  "author": "Hormes contributors",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import ./scripts/test-preload.mjs --test --test-concurrency=4 'packages/*/src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "check": "pnpm run typecheck && pnpm run test && pnpm run doctor",
    "hormes": "tsx packages/cli/src/main.ts",
    "build:hands": "tsx scripts/build-hands.ts",
    "build:icon": "tsx scripts/make-icon.ts",
    "build:icon:windows": "tsx scripts/make-windows-icon.ts",
    "hormesd": "tsx packages/daemon/src/main.ts",
    "build:mac": "tsx scripts/build-mac.ts",
    "build:ios": "zsh apps/ios/Scripts/build.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.267",
    "@anthropic-ai/sdk": "^0.116.0",
    "@hormes/agents": "workspace:*",
    "@hormes/brain": "workspace:*",
    "@hormes/cli": "workspace:*",
    "@hormes/core": "workspace:*",
    "@hormes/daemon": "workspace:*",
    "@hormes/engine": "workspace:*",
    "@hormes/hands": "workspace:*",
    "@hormes/install": "workspace:*",
    "@hormes/live": "workspace:*",
    "@hormes/memory": "workspace:*",
    "@hormes/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
