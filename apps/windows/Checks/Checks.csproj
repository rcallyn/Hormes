<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline checks for the Windows app (apps/mac/Scripts' counterpart); see Program.cs for how to run them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hormes.Windows.Checks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hormes.Windows\Hormes.Windows.csproj" />
  </ItemGroup>

</Project>
