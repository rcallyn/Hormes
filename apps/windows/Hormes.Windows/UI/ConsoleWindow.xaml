<Window x:Class="Hormes.Windows.UI.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hormes Console" Width="720" Height="560" MinWidth="480" MinHeight="360"
        Background="#0B0B0C" Foreground="White" FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Hormes" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="StatusText" Foreground="#8E8E93" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="ProblemsText" Foreground="#FFB340" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#151517" CornerRadius="10" Padding="4">
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="Transcript" Margin="10,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Who}" Foreground="#8E8E93" FontSize="11"/>
                <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" Foreground="White"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <Button Content="Send" DockPanel.Dock="Right" Padding="16,6" Margin="8,0,0,0" Click="Send_Click"/>
      <TextBox x:Name="Composer" Background="#1C1C1E" Foreground="White" CaretBrush="White" BorderBrush="#3A3A3C"
               FontSize="14" Padding="8,6" KeyDown="Composer_KeyDown"/>
    </DockPanel>
  </Grid>
</Window>
